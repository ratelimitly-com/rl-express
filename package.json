{
  "name": "ratelimitly-express",
  "version": "1.0.0",
  "description": "Express middleware for RateLimitly centralized rate limiting, latency guards, and load shedding",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js && npm run test:types",
    "test:unit": "node --test test/middleware.test.js test/headers.test.js test/client_factory.test.js test/latency.test.js test/latency_tracker.test.js test/fail_modes.test.js",
    "test:integration": "node --test test/integration.test.js test/wire_integration.test.js",
    "test:package": "node test/package_consumer.js",
    "test:types": "tsc --project test/tsconfig.json",
    "prepublishOnly": "npm test && npm run test:package"
  },
  "keywords": [
    "rate-limit",
    "rate-limiting",
    "express",
    "express-middleware",
    "ratelimitly",
    "load-shedding",
    "latency-guards",
    "admission-control",
    "distributed-rate-limiting"
  ],
  "author": "RateLimitly Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ratelimitly-client": "2.0.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/express": "4.17.23",
    "express": "^4.21.2",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratelimitly-com/rl-express.git"
  },
  "bugs": {
    "url": "https://github.com/ratelimitly-com/rl-express/issues"
  },
  "homepage": "https://github.com/ratelimitly-com/rl-express#readme"
}
